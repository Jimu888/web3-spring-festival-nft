# WalletConnect 项目ID
# 从 https://cloud.walletconnect.com/ 创建项目获取
VITE_WALLETCONNECT_PROJECT_ID=1af1fbb236796546d0d0dc7d80a3fa1b

# 合约地址
# BSC 主网（已部署）
VITE_CONTRACT_ADDRESS_BSC=0x3E7305b8377800dEcC2B4359C25BC3fDBdAD9843
# BSC 测试网（可选：没有就先留空）
VITE_CONTRACT_ADDRESS_BSC_TESTNET=

# Web3.Storage API Token
# 从 https://web3.storage/ 注册获取
WEB3_STORAGE_TOKEN=your_web3_storage_token

# BSC 部署私钥 (仅用于合约部署)
# ⚠️ 注意: 请使用专门的部署钱包，不要使用主钱包私钥
PRIVATE_KEY=your_deployment_private_key

# NFT 基础信息
VITE_NFT_NAME=Web3春节联欢晚会2026纪念徽章
VITE_NFT_SYMBOL=SFBADGE2026
VITE_NFT_DESCRIPTION=庆祝中华传统新年与Web3科技的完美融合

# IPFS 网关 (可选)
